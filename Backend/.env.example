# Environment Variables for DuGod Backend
NODE_ENV=production
PORT=3001

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dugod?retryWrites=true&w=majority

# Storage API (storageapi.dev)
STORAGE_API_URL=https://t3.storageapi.dev
STORAGE_BUCKET_NAME=your_bucket_name
STORAGE_TOKEN_ID=your_token_id
STORAGE_TOKEN_SECRET=your_token_secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# ZeptoMail
ZEPTO_API_TOKEN=your_zepto_api_token
ZEPTO_DOMAIN=your_zepto_domain.com

# Vercel
VERCEL_TOKEN=your_vercel_token
