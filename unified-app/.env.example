# Environment Variables for Dugod Unified App

NODE_ENV=production

# App URLs
NEXT_PUBLIC_APP_URL=https://dugodofficial.com
NEXT_PUBLIC_ADMIN_URL=https://admin.dugodofficial.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dugod
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/dugod
MONGODB_DATABASE=dugod

# Auth
SECRET_KEY=your_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Storage API (storageapi.dev)
STORAGE_API_URL=https://t3.storageapi.dev
STORAGE_BUCKET_NAME=your_bucket_name
STORAGE_TOKEN_ID=your_token_id
STORAGE_TOKEN_SECRET=your_token_secret

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_CALLBACK_URL=https://dugodofficial.com/api/payments/callback/paystack
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ZeptoMail
ZEPTO_API_TOKEN=your_zepto_api_token
ZEPTO_DOMAIN=your_domain.com
ZEPTO_URL=https://api.zeptomail.com

# Cron
CRON_SECRET=your_cron_secret

# Vercel
VERCEL_TOKEN=your_vercel_token
