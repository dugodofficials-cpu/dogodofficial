{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonDugodS3Buckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::dugodofficial-media",
        "arn:aws:s3:::dugodofficial-media/*",
        "arn:aws:s3:::dugodofficial-public",
        "arn:aws:s3:::dugodofficial-public/*"
      ]
    }
  ]
}
